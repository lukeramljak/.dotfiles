{
	"$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
	"runtime": {
		"version": "LuaJIT"
	},
	"diagnostics": {
		"globals": ["vim"]
	},
	"workspace": {
		"checkThirdParty": false,
		"library": [
			"$VIMRUNTIME/lua",
			"${3rd}/luv/library",
			"lua/icons.lua",
			"lua/lightbulb.lua",
			"lua/vim-pack.lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/arborist.nvim/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/catppuccin/lua/catppuccin",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/codediff.nvim/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/conform.nvim/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/fzf-lua/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/gitsigns.nvim/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/grug-far.nvim/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.ai/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.bufremove/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.clue/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.files/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.icons/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.splitjoin/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.statusline/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.tabline/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-autopairs/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-treesitter-context/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-ts-autotag/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/quicker.nvim/lua",
			"$XDG_DATA_HOME/nvim/site/pack/core/opt/snacks.nvim/lua"
		]
	}
}
